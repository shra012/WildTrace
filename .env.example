# WildTrace runtime environment
#
# Current default flow:
# - Bronze enrichment: BioCLIP from Hugging Face on CUDA
# - Silver outline generator: informative-drawings
# - Silver outline rectifier: local silhouette rectifier
# - Silver outline validator: Ollama model
# - Future Anthropic validator support is optional and only activates if
#   ANTHROPIC_API_KEY is present or SEMANTIC_VALIDATOR_BACKEND is set.

# Ollama endpoint for the current outline validator path.
OLLAMA_HOST=http://localhost:11434

# Silver outline validator model used by the auto validator path when
# Anthropic is not configured.
OLLAMA_VALIDATOR_MODEL=qwen2.5vl:7b

# Bronze enrichment model from Hugging Face.
HF_ENRICHMENT_MODEL=imageomics/bioclip

# Hugging Face cache directory for BioCLIP and informative-drawings assets.
HF_HOME=~/.cache/huggingface

# Real informative-drawings ONNX backend for silver line-diagram generation.
INFORMATIVE_DRAWINGS_REPO=rocca/informative-drawings-line-art-onnx
INFORMATIVE_DRAWINGS_FILENAME=model.onnx

# Optional future rectifier model if we later switch from the local silhouette
# rectifier to a FLUX Kontext-based editor.
# OUTLINE_RECTIFIER_MODEL=black-forest-labs/FLUX.1-Kontext-dev

# BioCLIP is expected to run on GPU.
# Examples: cuda, cuda:0
BIOCLIP_DEVICE=cuda

# Optional: force the outline validator backend instead of using auto detection.
# SEMANTIC_VALIDATOR_BACKEND=ollama_semantic_validator
# SEMANTIC_VALIDATOR_BACKEND=anthropic_semantic_validator

# Optional future Anthropic configuration.
# If ANTHROPIC_API_KEY is set and the backend is auto, the outline validator
# can switch to Anthropic automatically.
# ANTHROPIC_API_KEY=your_key_here
# ANTHROPIC_MODEL=claude-haiku-4-5
# ANTHROPIC_API_BASE=https://api.anthropic.com

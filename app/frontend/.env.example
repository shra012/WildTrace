# Base URL of the WildTrace Studio FastAPI backend (no trailing slash).
NEXT_PUBLIC_API_BASE=http://localhost:8000
# Optional explicit WebSocket URL. Defaults to the API base with ws(s):// and /ws.
# NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
# Set to 1 to run the UI against built-in mock data (no backend needed).
NEXT_PUBLIC_MOCK=0
